._*
.AppleDouble
.LSOverride
Icon?
.Spotlight-V100
.Trashes
.fseventsd
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
.fuse_hidden*
.directory

# ============================================================
