# ============================================================
.idea/
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.iml
*.sublime-project
*.sublime-workspace

# ============================================================
# Claude Code 本地配置
# ============================================================
.claude/

# ============================================================
# Node / Next.js（app/ 子目录）
# ============================================================
app/node_modules/
app/.next/
app/out/
app/build/
app/dist/
app/.swc/
app/.turbo/
app/.output/
app/.parcel-cache/
app/next-env.d.ts
app/.eslintcache
app/tsconfig.tsbuildinfo

# 环境变量（含密钥，永远不入仓）
app/.env
app/.env.local
app/.env*.local
app/.env.production
app/.env.development.local

# Vercel 本地构建产物（vercel deploy 后生成）
app/.vercel/

# 包管理器缓存（lock 文件保留入仓，仅缓存忽略）
app/.yarn/cache/
app/.yarn/install-state.gz
app/.yarn/build-state.yml
app/.yarn/unplugged/
app/.pnpm-store/

# 测试输出
app/coverage/
app/.nyc_output/

# ============================================================
# 日志
# ============================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ============================================================
# 运行时
# ============================================================
*.pid
*.seed
*.pid.lock

# ============================================================
# Python（偶尔用 python3 跑数据脚本时产生）
# ============================================================
__pycache__/
*.py[cod]
*$py.class
.Python
.pytest_cache/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ============================================================
# 调研原始数据（大文件 + 隐私考虑）
# ============================================================
# all_comments.json 是 TikTok 原始爬取数据 (786KB)
# 不入仓的原因：
# 1. 文件较大，污染 git 历史
# 2. data-context.md 已描述数据来源/字段/局限，足够追溯
# 3. 真要复用可重新跑爬虫
all_comments.json

# ============================================================
# 临时 / 缓存
# ============================================================
*.tmp
*.cache
*.bak
*.orig

# 仓库根的 tmp 目录（仅匹配根，不影响 /tmp 系统）
/tmp/
